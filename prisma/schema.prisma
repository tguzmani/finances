generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id             Int                  @id @default(autoincrement())
  date           DateTime
  amount         Decimal              @db.Decimal(10, 2)
  currency       String               @db.VarChar(10)
  transactionId  String               @unique @map("transaction_id")
  status         TransactionStatus    @default(NEW)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  type           TransactionType      @default(EXPENSE)
  description    String?
  imageUrl       String?              @map("image_url")
  ocrText        String?              @map("ocr_text")
  platform       TransactionPlatform
  method         PaymentMethod?
  journalEntries JournalEntry[]

  @@map("transactions")
}

model Exchange {
  id               Int            @id @default(autoincrement())
  orderNumber      String         @unique @map("order_number")
  asset            String         @db.VarChar(10)
  amount           Decimal        @db.Decimal(18, 8)
  amountGross      Decimal        @map("amount_gross") @db.Decimal(18, 8)
  fiatSymbol       String         @map("fiat_symbol") @db.VarChar(3)
  fiatAmount       Decimal        @map("fiat_amount") @db.Decimal(18, 2)
  exchangeRate     Decimal        @map("exchange_rate") @db.Decimal(18, 4)
  counterparty     String?        @db.VarChar(255)
  tradeType        TradeType      @map("trade_type")
  status           ExchangeStatus @default(COMPLETED)
  binanceCreatedAt DateTime       @map("binance_created_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([binanceCreatedAt])
  @@index([status])
  @@map("exchanges")
}

model ExchangeRate {
  id     Int                 @id @default(autoincrement())
  date   DateTime            @default(now())
  value  Decimal             @db.Decimal(10, 2)
  source ExchangeRateSource  @default(INTERNAL)

  @@index([date])
  @@index([source])
  @@map("exchange_rates")
}

enum TransactionStatus {
  NEW
  REVIEWED
  REGISTERED
  REJECTED
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

enum TransactionPlatform {
  BANESCO
  BINANCE
  BANK_OF_AMERICA
  WALLET
  CASH_BOX
}

enum PaymentMethod {
  DEBIT_CARD
  PAGO_MOVIL
  ELECTRONIC_TRANSFER
  ZELLE
  CREDIT_CARD
  BINANCE_PAY
  DEPOSIT
  WITHDRAWAL
  CASH
}

enum ExchangeStatus {
  COMPLETED
  PROCESSING
  PENDING
  CANCELLED
  FAILED
  REVIEWED
  REJECTED
  REGISTERED
}

enum TradeType {
  BUY
  SELL
}

enum ExchangeRateSource {
  INTERNAL
  BINANCE_P2P
  BCV
  BCV_EUR
}

model EquitySnapshot {
  id     Int        @id @default(autoincrement())
  date   DateTime   @default(now())
  name   EquityName
  amount Decimal    @db.Decimal(14, 2)

  @@index([date])
  @@index([name])
  @@map("equity_snapshots")
}

enum EquityName {
  EQUITY_SIMPLE
  EQUITY_FULL_INVESTMENT
  EQUITY_CRYPTO_INVESTMENT
  EQUITY_FIAT_INVESTMENT
}

enum JournalEntryType {
  DEBIT
  CREDIT
}

model GoogleSheetConfig {
  id             Int      @id @default(autoincrement())
  googleSheetId  String   @map("google_sheet_id")
  name           String
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([startDate, endDate])
  @@map("google_sheet_configs")
}

model JournalEntry {
  id            Int              @id @default(autoincrement())
  transactionId Int              @map("transaction_id")
  transaction   Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  type          JournalEntryType
  account       String
  category      String           @default("")
  subcategory   String           @default("")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@map("journal_entries")
}

/// A /done: the moment the ledger is up to date, with a snapshot of every balance.
model Closing {
  id           Int              @id @default(autoincrement())
  closedAt     DateTime         @default(now()) @map("closed_at")
  outcome      ClosingOutcome?
  note         String?
  exchangeRate Decimal?         @map("exchange_rate") @db.Decimal(10, 2)
  answeredAt   DateTime?        @map("answered_at")
  balances     ClosingBalance[]
  checkIns     CheckIn[]

  @@index([closedAt])
  @@map("closings")
}

/// One account as it stood at a closing. `account` is a plain string so a new
/// account needs no migration.
model ClosingBalance {
  id                   Int      @id @default(autoincrement())
  closingId            Int      @map("closing_id")
  closing              Closing  @relation(fields: [closingId], references: [id], onDelete: Cascade)
  account              String   @db.VarChar(32)
  currency             String   @db.VarChar(10)
  sheetBalance         Decimal  @map("sheet_balance") @db.Decimal(14, 2)
  estimatedBalance     Decimal  @map("estimated_balance") @db.Decimal(14, 2)
  actualBalance        Decimal? @map("actual_balance") @db.Decimal(14, 2)
  pendingTxCount       Int      @default(0) @map("pending_tx_count")
  pendingExchangeCount Int      @default(0) @map("pending_exchange_count")

  @@index([closingId])
  @@map("closing_balances")
}

enum ClosingOutcome {
  ALL_GOOD
  SOME_ISSUES
  BAD
}

/// The nightly "is everything registered?" question, answered or not.
model CheckIn {
  id                Int                @id @default(autoincrement())
  sentAt            DateTime           @default(now()) @map("sent_at")
  trigger           CheckInTrigger
  banescoTrackedVes Decimal?           @map("banesco_tracked_ves") @db.Decimal(14, 2)
  upToDate          Boolean?           @map("up_to_date")
  initiative        CheckInInitiative?
  missReason        CheckInMissReason? @map("miss_reason")
  note              String?
  closingId         Int?               @map("closing_id")
  closing           Closing?           @relation(fields: [closingId], references: [id], onDelete: SetNull)
  answeredAt        DateTime?          @map("answered_at")

  @@index([sentAt])
  @@map("check_ins")
}

enum CheckInTrigger {
  SCHEDULED
  MANUAL
}

enum CheckInInitiative {
  OWN
  REMINDER
}

enum CheckInMissReason {
  FORGOT
  COMPLEX_TRANSACTION
  OTHER
}
